# Inkvoice PWA — Hostinger/LiteSpeed.
# The web app manifest is now manifest.json (an extension the server serves natively
# as application/json, which browsers accept), so the home-screen icon no longer
# depends on this file surviving a deploy. This block is a belt-and-suspenders that
# forces the correct manifest MIME type even if the server default ever changes.
<Files "manifest.json">
  ForceType application/manifest+json
</Files>
<Files "manifest.webmanifest">
  ForceType application/manifest+json
</Files>
# Always revalidate the manifest so a fixed one is never masked by a stale cache.
<IfModule mod_headers.c>
  <FilesMatch "manifest\.(json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Icons + favicon: cache HARD and immutably. The icon URL already carries a version
  # query (?v=NN) that changes ONLY when the artwork changes, so a given URL always maps
  # to the same bytes — it is safe (and correct) to let the browser/OS keep it forever.
  # The previous "max-age=0, must-revalidate" was actively harmful: must-revalidate
  # FORBIDS using the cached icon without a successful server round-trip, so any offline
  # moment / network blip / server hiccup while the OS re-rendered the home-screen icon
  # after an update dropped it to the generic Android icon. Immutable caching means once
  # the device has the icon it never needs the network again → the icon survives updates.
  <FilesMatch "\.(png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
